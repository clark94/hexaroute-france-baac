# COPIER ce fichier sous .env uniquement sur son ordinateur (jamais dans GitHub).
# Aller dans Snowflake > menu profil > account identifier pour renseigner ACCOUNT.
SNOWFLAKE_ACCOUNT=mon_compte.mon_region
SNOWFLAKE_USER=mon_utilisateur
SNOWFLAKE_PASSWORD=mettre_mon_mot_de_passe_localement
SNOWFLAKE_WAREHOUSE=RETAIL_WH
SNOWFLAKE_DATABASE=HEXAROUTE_DB
SNOWFLAKE_SCHEMA=ANALYTICS
