# Ne JAMAIS publier les secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.p8
*.key

# Environnements et caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.DS_Store

# Données sources de grande taille et fichiers transformés
# Le téléchargement officiel reproduit exactement ces fichiers.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet

# Fichiers temporaires
*.part
*.log
